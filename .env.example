# Copy to .env and fill in. .env is ignored by Git.
FOOTBALL_API_KEY=
FOOTBALL_API_BASE=https://api.football-data.org/v4
FOOTBALL_COMPETITIONS=PL,PD,BL1,SA,FL1
FOOTBALL_LIVE_INTERVAL=60
FOOTBALL_DAY_INTERVAL=900
FOOTBALL_IDLE_INTERVAL=1800
FOOTBALL_RETRY_DELAY=60
FOOTBALL_TIMEOUT=10

# Realtime Trains NG (train times). A refresh token is exchanged for a
# short-life access token; a long-life access token can use TRAINS_API_KEY.
TRAINS_REFRESH_TOKEN=
# TRAINS_API_KEY=
TRAINS_TIMEOUT=10
